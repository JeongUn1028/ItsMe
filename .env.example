# ---- 인증 ----
# JWT 서명 키 (충분히 긴 랜덤 문자열)
JWT_SECRET_KEY=
# 관리자 아이디
ADMIN_USERNAME=
# 관리자 비밀번호 해시. 생성: node scripts/hash-password.mjs '<비밀번호>'
ADMIN_PASSWORD_HASH=

# ---- GitHub (콘텐츠 저장소) ----
# 콘텐츠 리포지토리에 쓰기 권한이 있는 토큰 (Contents: Read and write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# 생략 시 main
GITHUB_BRANCH=main

# ---- 사이트 ----
# metadataBase 용 공개 URL (Vercel 에서는 생략 가능)
NEXT_PUBLIC_SITE_URL=
